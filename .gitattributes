# Repository files should match what the CI runner sees.
# scripts/build.mjs reads icon sources byte-for-byte; a CRLF checkout bakes
# carriage returns into docs/js/icons.js and makes `--check` fail for
# Windows contributors even when the committed content is correct.
* text=auto eol=lf

*.svg    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# Never touch these.
*.png    binary
*.jpg    binary
*.ico    binary
